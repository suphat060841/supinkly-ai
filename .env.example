# ─────────────────────────────────────────────────────────────
# Supinkly.AI - Environment Variables Template
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# ⚠️ อย่า commit ไฟล์ .env ขึ้น git เด็ดขาด!
# ─────────────────────────────────────────────────────────────

# Server
PORT=3000

# CORS - domains ที่อนุญาต (คั่นด้วย comma)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Admin PIN (จะถูก hash อัตโนมัติเมื่อ server เริ่มครั้งแรก)
ADMIN_PIN=your_strong_pin_here

# Salt สำหรับ hash PIN (ตั้งค่าให้ random อย่างน้อย 32 ตัวอักษร)
PIN_SALT=your_random_salt_32chars_minimum

# PromptPay
PROMPTPAY_NUMBER=0900000000
PROMPTPAY_NAME=ชื่อ นามสกุล

# SlipOK API (อย่าใส่ใน code โดยตรง!)
SLIPOK_API_KEY=SLIPOKXXXXXXXX
SLIPOK_BRANCH_ID=12345
